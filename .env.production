# Public Supabase config — safe to commit.
# NEXT_PUBLIC_* values are inlined into the browser bundle by design; the
# publishable (anon) key is meant to be public and is protected by RLS.
# Committing these guarantees the production build always has them, regardless
# of the Vercel dashboard env state. Vercel-defined env vars (if set) override.
#
# NEVER put secrets here (SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY, STRIPE_SECRET_KEY) — those stay as Vercel env vars only.
NEXT_PUBLIC_SUPABASE_URL=https://enqaxzkvpbjkypfaxbzg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1MGe_aThkiCO11GOyDhsbw_t72pMNjC
